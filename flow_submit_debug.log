t bị này được đặt trên nền trắng. title: visible:true] map[ariaHasPopup:dialog ariaLabel: class:sc-e8425ea6-0 hOBPaw sc-d3791a4f-0 sc-d3791a4f-4 sc-253cad92-0 ewGlDn famhRe joSmHx id: text:add_2Tạo title: visible:true] map[ariaHasPopup: ariaLabel: class:sc-59223abb-3 dmZGYv id: text:Tác nhân title: visible:true] map[ariaHasPopup:menu ariaLabel: class:sc-16c4830a-1 dnFqQq sc-e7a64add-0 sc-e7a64add-1 fPutAP jmLZrS sc-93abd9dc-1 ldbhld id:radix-:rn: text:🍌 Nano Banana Procrop_9_16x2 title: visible:true] map[ariaHasPopup: ariaLabel: class:sc-e8425ea6-0 hOBPaw sc-d3791a4f-0 sc-d3791a4f-4 sc-26b30722-5 ewGlDn famhRe jDvIwb id: text:arrow_forwardTạo title: visible:true] map[ariaHasPopup: ariaLabel: class:sc-eb68e7f-2 jrTHnf flow_tab_slider_trigger id:radix-:r1d:-trigger-IMAGE text:imageHình ảnh title: visible:true] map[ariaHasPopup: ariaLabel: class:sc-eb68e7f-2 jrTHnf flow_tab_slider_trigger id:radix-:r1d:-trigger-VIDEO text:play_circleVideo title: visible:true] map[ariaHasPopup: ariaLabel: class:sc-eb68e7f-2 dNQytQ flow_tab_slider_trigger id:radix-:r1g:-trigger-LANDSCAPE text:crop_16_916:9 title: visible:true] map[ariaHasPopup: ariaLabel: class:sc-eb68e7f-2 dNQytQ flow_tab_slider_trigger id:radix-:r1g:-trigger-LANDSCAPE_4_3 text:crop_landscape4:3 title: visible:true] map[ariaHasPopup: ariaLabel: class:sc-eb68e7f-2 dNQytQ flow_tab_slider_trigger id:radix-:r1g:-trigger-SQUARE text:crop_square1:1 title: visible:true] map[ariaHasPopup: ariaLabel: class:sc-eb68e7f-2 dNQytQ flow_tab_slider_trigger id:radix-:r1g:-trigger-PORTRAIT_3_4 text:crop_portrait3:4 title: visible:true] map[ariaHasPopup: ariaLabel: class:sc-eb68e7f-2 dNQytQ flow_tab_slider_trigger id:radix-:r1g:-trigger-PORTRAIT text:crop_9_169:16 title: visible:true] map[ariaHasPopup: ariaLabel: class:sc-eb68e7f-2 DoEQM flow_tab_slider_trigger id:radix-:r1m:-trigger-1 text:1x title: visible:true] map[ariaHasPopup: ariaLabel: class:sc-eb68e7f-2 DoEQM flow_tab_slider_trigger id:radix-:r1m:-trigger-2 text:x2 title: visible: